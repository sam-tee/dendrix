theme: variant: let
  name = "${theme.name}-${variant}";
  inherit (theme) author opacity;
  base_ = "${theme.${variant}.base00}00"; #fully transparent for placeholders
  baseBG = "${theme.${variant}.base00}${opacity}";
  baseBG_alt = "${theme.${variant}.base01}${opacity}";
in {
  "$schema" = "https://zed.dev/schema/themes/v0.2.0.json";
  inherit author name;
  themes = with theme.${variant}; [
    {
      appearance = variant;
      inherit name;
      style = {
        background = baseBG;
        "background.appearance" =
          if opacity == "FF"
          then "opaque"
          else "blurred";
        border = base04;
        "border.variant" = base04;
        "border.focused" = base04;
        "border.disabled" = base04;
        "border.selected" = base04;
        "border.transparent" = base04;
        conflict = base0A;
        "conflict.background" = base01;
        "conflict.border" = base0A;
        created = base0B;
        "created.background" = base01;
        "created.border" = base0B;
        deleted = base08;
        "deleted.background" = base01;
        "deleted.border" = base08;
        "editor.background" = base_;
        "editor.gutter.background" = base_;
        "editor.line_number" = base03;
        "editor.active_line_number" = base04;
        "editor.active_line.background" = base01;
        "editor.wrap_guide" = base03;
        "editor.active_wrap_guide" = base04;
        "editor.indent_guide" = base03;
        "editor.indent_guide_active" = base04;
        "element.active" = base02;
        "element.background" = baseBG_alt;
        "element.hover" = base02;
        "element.selected" = base03;
        "element.selection_background" = base02;
        "element.disabled" = base03;
        "elevated_surface.background" = base00;
        "editor.document_highlight.bracket_background" = base02;
        "editor.document_highlight.write_background" = base02;
        "editor.document_highlight.read_background" = base02;
        error = base08;
        "error.background" = "${base08}1f";
        "error.border" = base08;
        "ghost_element.background" = baseBG_alt;
        "ghost_element.active" = base03;
        "ghost_element.hover" = base02;
        "ghost_element.selected" = base03;
        "ghost_element.disabled" = base03;
        hidden = base04;
        "hidden.background" = base01;
        "hidden.border" = base04;
        hint = base04;
        "hint.background" = base01;
        "hint.border" = base04;
        icon = base0E;
        "icon.accent" = base0E;
        "icon.disabled" = base01;
        "icon.muted" = "${base0E}50";
        "icon.placeholder" = base01;
        ignored = base04;
        "ignored.background" = base01;
        "ignored.border" = base04;
        info = base0C;
        "info.background" = "${base0C}1f";
        "info.border" = base0C;
        "link_text.hover" = base0D;
        modified = base0A;
        "modified.background" = base01;
        "modified.border" = base0A;
        "pane.focused_border" = base05;
        "pane_group.border" = base00;
        "panel.background" = baseBG;
        "panel.focused_border" = base04;
        "panel.indent_guide" = base03;
        "panel.indent_guide_active" = base04;
        "panel.indent_guide_hover" = base04;
        "panel.overlay_background" = base01;
        "panel.overlay_hover" = base02;
        players = [
          {
            "cursor" = base05;
            "background" = base05;
            "selection" = base02;
          }
        ];
        predictive = base04;
        "predictive.background" = base01;
        "predictive.border" = base04;
        renamed = base0D;
        "renamed.background" = base01;
        "renamed.border" = base0D;
        "scrollbar.thumb.background" = base02;
        "scrollbar.thumb.hover_background" = base03;
        "scrollbar.thumb.active_background" = base0E;
        "scrollbar.thumb.border" = base02;
        "scrollbar.track.background" = base_;
        "scrollbar.track.border" = base_;
        "search.match_background" = "${base0C}1f";
        "status_bar.background" = baseBG;
        success = base0B;
        "success.background" = "${base0B}1f";
        "success.border" = base0B;
        "surface.background" = base0F;
        syntax = {
          attribute.color = base09;
          boolean.color = base09;
          character.color = base0C;
          "character.special".color = base0F;
          comment.color = base04;
          "comment.doc".color = base04;
          "comment.documentation".color = base04;
          "comment.error".color = base08;
          "comment.hint".color = base0D;
          "comment.note".color = base06;
          "comment.todo".color = base0F;
          "comment.warning".color = base0A;
          concept.color = base0D;
          constant.color = base06;
          "constant.builtin".color = base09;
          "constant.macro".color = base0E;
          constructor.color = base0F;
          "diff.minus".color = base08;
          "diff.plus".color = base0B;
          embedded.color = base0F;
          emphasis.color = base0F;
          "emphasis.strong".color = base0F;
          enum.color = base0C;
          field.color = base07;
          float.color = base09;
          function.color = base0D;
          "function.builtin".color = base09;
          "function.call".color = base0D;
          "function.decorator".color = base09;
          "function.macro".color = base0C;
          "function.method".color = base0D;
          "function.method.call".color = base0D;
          hint.color = base04;
          keyword.color = base0E;
          "keyword.conditional".color = base0E;
          "keyword.conditional.ternary".color = base0E;
          "keyword.coroutine".color = base0E;
          "keyword.debug".color = base0E;
          "keyword.directive".color = base0F;
          "keyword.directive.define".color = base0F;
          "keyword.exception".color = base0E;
          "keyword.export".color = base0D;
          "keyword.function".color = base0E;
          "keyword.import".color = base0E;
          "keyword.modifier".color = base0E;
          "keyword.operator".color = base0E;
          "keyword.repeat".color = base0E;
          "keyword.return".color = base0E;
          "keyword.type".color = base0E;
          label.color = base0D;
          link_text.color = base0D;
          link_uri.color = base06;
          module.color = base0A;
          namespace.color = base0A;
          number.color = base0C;
          "number.float".color = base0C;
          operator.color = base0D;
          parameter.color = base0F;
          parent.color = base09;
          predictive.color = base04;
          predoc.color = base08;
          primary.color = base0F;
          property.color = base0D;
          punctuation.color = base05;
          "punctuation.bracket".color = base05;
          "punctuation.delimiter".color = base05;
          "punctuation.list_marker".color = base0C;
          "punctuation.special".color = base0F;
          "punctuation.special.symbol".color = base0F;
          string.color = base0B;
          "string.doc".color = base0C;
          "string.documentation".color = base0C;
          "string.escape".color = base05;
          "string.regex".color = base05;
          "string.regexp".color = base05;
          "string.special".color = base0F;
          "string.special.path".color = base0F;
          "string.special.symbol".color = base0F;
          "string.special.url".color = base06;
          symbol.color = base0F;
          tag.color = base0D;
          "tag.attribute".color = base0A;
          "tag.delimiter".color = base0C;
          "tag.doctype".color = base0E;
          text.color = base05;
          "text.literal".color = base0B;
          title.color = base05;
          type.color = base0A;
          "type.builtin".color = base0E;
          "type.class.definition".color = base0A;
          "type.definition".color = base0A;
          "type.interface".color = base0A;
          "type.super".color = base0A;
          variable.color = base05;
          "variable.builtin".color = base08;
          "variable.member".color = base0D;
          "variable.parameter".color = base0F;
          "variable.special".color = base0F;
          variant.color = base08;
        };
        "tab_bar.background" = base_;
        "tab.inactive_background" = base_;
        "tab.active_background" = base_;
        "terminal.ansi.background" = base_;
        "terminal.ansi.black" = base00;
        "terminal.ansi.blue" = base0D;
        "terminal.ansi.bright_black" = base03;
        "terminal.ansi.bright_blue" = base0D;
        "terminal.ansi.bright_cyan" = base0C;
        "terminal.ansi.bright_green" = base0B;
        "terminal.ansi.bright_magenta" = base0E;
        "terminal.ansi.bright_red" = base08;
        "terminal.ansi.bright_white" = base07;
        "terminal.ansi.bright_yellow" = base0A;
        "terminal.ansi.cyan" = base0C;
        "terminal.ansi.dim_black" = base00;
        "terminal.ansi.dim_blue" = base0D;
        "terminal.ansi.dim_cyan" = base0C;
        "terminal.ansi.dim_green" = base0B;
        "terminal.ansi.dim_magenta" = base0E;
        "terminal.ansi.dim_red" = base08;
        "terminal.ansi.dim_white" = base04;
        "terminal.ansi.dim_yellow" = base0A;
        "terminal.ansi.green" = base0B;
        "terminal.ansi.magenta" = base0E;
        "terminal.ansi.red" = base08;
        "terminal.ansi.white" = base05;
        "terminal.ansi.yellow" = base0A;
        "terminal.background" = base_;
        "terminal.bright_foreground" = base05;
        "terminal.dim_foreground" = base04;
        "terminal.foreground" = base05;
        text = base05;
        "text.accent" = base0E;
        "text.disabled" = base03;
        "text.muted" = base04;
        "text.placeholder" = base04;
        "title_bar.background" = baseBG;
        "title_bar.background_inactive" = baseBG_alt;
        "toolbar.background" = base_;
        unreachable = base03;
        "unreachable.background" = "${base03}1f";
        "unreachable.border" = base03;
        "vim.mode.text" = base05;
        "vim.normal.foreground" = base00;
        "vim.normal.background" = base0E;
        "vim.visual.foreground" = base00;
        "vim.visual.background" = base0B;
        "vim.visual_block.foreground" = base00;
        "vim.visual_block.background" = base0B;
        "vim.insert.foreground" = base00;
        "vim.insert.background" = base0F;
        warning = base0A;
        "warning.background" = "${base0A}1f";
        "warning.border" = base0A;
      };
    }
  ];
}
